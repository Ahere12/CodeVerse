# Copy to .env.local and fill in from Supabase → Project Settings → API.
# These two values are public by design; security comes from Row Level Security.
# Never put the service_role key in this file.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: which sign-in buttons to show (default: all three)
# VITE_AUTH_PROVIDERS=github,discord,google
